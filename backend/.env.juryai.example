# ── Inherited from legal-platform .env ──────────────────────────
POSTGRES_USER=postgres
# Secrets: supply real values here (this file is an example — do NOT commit real .env)
POSTGRES_PASSWORD=
POSTGRES_DB=legal_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Dedicated schema so JuryAI's tables never collide with the sibling
# legal-platform backend's tables if both share POSTGRES_DB
POSTGRES_SCHEMA=juryai

# Audit log (durable, Postgres-backed record of every chat turn for compliance)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_MAX_ATTEMPTS=3
AUDIT_LOG_RETRY_BASE_SECONDS=0.25
AUDIT_LOG_WRITE_TIMEOUT_SECONDS=5.0

# Valkey (Redis-protocol) — answer cache + memory + rate-limit store
VALKEY_URL=redis://localhost:6379/1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
S3_DOCUMENT_PREFIX=documents

# ── JURYAI specific ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=juryai_legal
QDRANT_API_KEY=

QUICKWIT_URL=http://localhost:7280
QUICKWIT_INDEX=juryai_legal

# Free-LLM Gateway model alias (gateway auto-routes to best available provider)
GATEWAY_MODEL=llama-3.3-70b

# LLM providers (add whichever you have — priority: Groq > Mistral > OpenAI > Ollama)
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web search (all optional — falls back to free DuckDuckGo if none set)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Result count for the generic web search pass
WEB_SEARCH_MAX_RESULTS=8
# Result count for the Wigolo-only government/judiciary domain-scoped pass
WEB_SEARCH_GOVERNMENT_MAX_RESULTS=5
# Official Indian gov/judiciary domains for the Wigolo domain-scoped pass (JSON array string)
GOVERNMENT_SEARCH_DOMAINS=["indiacode.nic.in","legislative.gov.in","egazette.gov.in","sci.gov.in","ecourts.gov.in","judis.nic.in","indiankanoon.org"]

EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
